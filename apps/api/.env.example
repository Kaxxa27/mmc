# My Movie Catalog API configuration.
#
# Local development: start Supabase (`npm run supabase:start` in the repo root), then run
# `npm run env:sync`. It writes apps/api/.env with the local Supabase URLs and keys and keeps any
# value you added yourself (for example the TMDB token). Put personal overrides in .env.local.
# Never commit .env files.

# --- HTTP server ---------------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# pretty | json
LOG_FORMAT=pretty
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log
# Set to true when running behind a reverse proxy / load balancer (uses X-Forwarded-For).
TRUST_PROXY=false
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Public URL of the web app; used in emails (invitation links, magic links).
WEB_APP_URL=http://localhost:3000
SWAGGER_ENABLED=true
# Background jobs (release reminders, cache cleanup).
JOBS_ENABLED=true
# Public URL of this API (used for the mock poster URLs). Defaults to http://HOST:PORT.
PUBLIC_API_URL=
# Developer endpoints under /api/v1/dev (quick sign-in, local mailbox, demo family) for testing
# in Swagger UI. Empty = on in development, off otherwise. Can never be enabled in production.
DEV_TOOLS_ENABLED=
MAILPIT_URL=http://127.0.0.1:54324
# General per-IP request limit.
RATE_LIMIT_PER_MINUTE=300

# --- Database (Supabase Postgres) --------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_POOL_MAX=10

# --- Supabase (Auth + Storage) ----------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key and secret (service role) key from `supabase status`.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed if access tokens are signed with the legacy HS256 secret; otherwise the API
# verifies tokens with the public keys published at /auth/v1/.well-known/jwks.json.
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=media

# --- TMDB (https://developer.themoviedb.org/) ---------------------------------------------------
# Where movie data comes from:
#   auto (default): live TMDB when a key below is set; without a key the built-in mock dataset in
#                   development, and the offline sample catalog in tests and production
#   live | mock | offline: force one mode
TMDB_MODE=auto
# Use the "API Read Access Token" (preferred) or the v3 "API Key".
TMDB_API_READ_ACCESS_TOKEN=
TMDB_API_KEY=
TMDB_DEFAULT_LANGUAGE=en-US
TMDB_DEFAULT_REGION=US
TMDB_TIMEOUT_MS=8000
# Delay for mock responses in milliseconds (to see loading states in the web app).
TMDB_MOCK_LATENCY_MS=0

# --- Outgoing email (invitations, notifications) --------------------------------------------------
# Locally this is Mailpit (web inbox: http://127.0.0.1:54324). Sign-in codes are sent by
# Supabase Auth itself (see supabase/config.toml).
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=My Movie Catalog <no-reply@my-movie-catalog.local>

# --- Passwordless sign-in protection ---------------------------------------------------------------
# Keep OTP_EXPIRY_SECONDS / OTP_RESEND_INTERVAL_SECONDS in sync with otp_expiry / max_frequency
# in supabase/config.toml.
OTP_EXPIRY_SECONDS=600
OTP_RESEND_INTERVAL_SECONDS=60
OTP_MAX_FAILED_ATTEMPTS=5
OTP_REQUESTS_PER_HOUR_PER_EMAIL=10
OTP_REQUESTS_PER_HOUR_PER_IP=30
OTP_VERIFICATIONS_PER_15_MIN_PER_IP=60

# --- Groups ---------------------------------------------------------------------------------------
INVITATION_TTL_DAYS=7
